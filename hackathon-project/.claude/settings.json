{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(**)",
      "Edit(requirements/**)",
      "Edit(architecture/**)",
      "Edit(frontend/**)",
      "Edit(backend/**)",
      "Edit(database/**)",
      "Edit(tests/**)",
      "Edit(deliverables/**)",
      "Edit(demo/**)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(npm install:*)",
      "Bash(npm run:*)",
      "Bash(npx:*)",
      "Bash(pip install:*)",
      "Bash(python:*)",
      "Bash(pytest:*)",
      "Bash(docker compose:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(docker:*)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/**)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "env": {
    "PROJECT_NAME": "hackathon-project"
  }
}
